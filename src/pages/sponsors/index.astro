---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import { SPONSORS } from '../../data/sponsors';
---
<BaseLayout
  title="Our Sponsors"
  description="The Florida businesses who donated goods, experiences, and services to support the Florida Lantern Project."
>
  <Hero
    eyebrow="Thank you"
    title="Our sponsors"
    lede={`${SPONSORS.length} Florida businesses donated goods, experiences, and services to support our work. None of them had to.`}
  />

  <Section>
    <ul class="sponsors">
      {SPONSORS.map((s) => (
        <li>
          <a href={`/sponsors/${s.slug}`}>
            <strong>{s.name}</strong>
            <span>{s.gift}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="surface" title="Become a sponsor">
    <p>
      Sponsorship can be goods, services, or direct support for a program or storm
      response. We'll tell you honestly which one helps most.
    </p>
    <p><a class="btn" href="/give/sponsor">Sponsorship information</a></p>
  </Section>
</BaseLayout>

<style>
  .sponsors { list-style: none; padding: 0; margin: var(--space-md) 0 0; display: grid; gap: var(--space-sm); grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); }
  .sponsors a {
    display: block; height: 100%; text-decoration: none;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent); border-radius: var(--radius);
    padding: var(--space-sm) var(--space-md);
  }
  .sponsors a:hover { border-left-color: var(--flp-navy-700); color: inherit; }
  .sponsors a:hover strong { color: var(--color-accent); }
  .sponsors strong { display: block; font-family: var(--font-display); font-size: var(--step-1); }
  .sponsors span { display: block; color: var(--color-text-muted); font-size: var(--step--1); margin-top: 0.2rem; }
</style>
