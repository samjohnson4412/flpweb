---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import { PRESS } from '../../data/press';
import { ORG } from '../../consts';

const broadcast = PRESS.filter((p) => p.kind === 'broadcast');
const articles = PRESS.filter((p) => p.kind === 'article');
---
<BaseLayout
  title="Press"
  description="Media coverage of the Florida Lantern Project and Sylvan Ramble Lights, including NBC Nightly News, Fox 13, WFLA, and the Tampa Bay Times."
>
  <Hero
    eyebrow="Press"
    title="Where we've turned up"
    lede="All of the coverage below is from our light show era, under the name Sylvan Ramble Lights. The disaster relief work hasn't been written about yet."
  />

  <Section title="Broadcast">
    <ul class="list">
      {broadcast.map((p) => (
        <li>
          <a href={p.url} rel="noopener">
            <strong>{p.outlet}</strong>
            <span>{p.title}{p.note ? ` — ${p.note}` : ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="surface" title="Print and online">
    <ul class="list">
      {articles.map((p) => (
        <li>
          <a href={p.url} rel="noopener">
            <strong>{p.outlet}</strong>
            <span>{p.title}{p.note ? ` — ${p.note}` : ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Press enquiries">
    <p>
      For interviews, footage, or background on our disaster response work,
      email <a href={`mailto:${ORG.email}`}>{ORG.email}</a> or call
      <a href={`tel:${ORG.phoneHref}`}>{ORG.phone}</a>. We can usually get you
      someone the same day during an active storm.
    </p>
    <p><a href="/about/transparency">Organization details and filings &rarr;</a></p>
  </Section>
</BaseLayout>

<style>
  .list { list-style: none; padding: 0; margin: var(--space-md) 0 0; display: grid; gap: 0; }
  .list li { border-bottom: 1px solid var(--color-border); }
  .list a { display: grid; grid-template-columns: minmax(9rem, 14rem) 1fr; gap: var(--space-sm); padding: 0.8rem 0; text-decoration: none; }
  .list a:hover span { color: var(--color-accent); }
  .list strong { font-family: var(--font-display); }
  .list span { color: var(--color-text-muted); }
  @media (max-width: 560px) { .list a { grid-template-columns: 1fr; gap: 0.1rem; } }
</style>
