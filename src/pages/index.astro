---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Card from '../components/Card.astro';
import Stats from '../components/Stats.astro';
import Story from '../components/Story.astro';
import CallToAction from '../components/CallToAction.astro';
import Figure from '../components/Figure.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import StormAlert from '../components/StormAlert.astro';
import heroPhoto from '../assets/photos/roof-inspection-drone.jpg';
import lightShow from '../assets/photos/light-show-crowd.jpg';
import audience from '../assets/photos/light-show-audience.jpg';
import { ORG, NOW, STORM } from '../consts';
---

<BaseLayout
  title={ORG.name}
  description="A Tampa 501(c)(3) providing emergency lodging, storm inspections, cleanup, and preparedness support to Florida families — stepping in where the official answer doesn't fit."
>
  <Hero
    title="No family should face disaster alone"
    lede="When a storm is coming, the official advice is to seek shelter. But shelters turn away pets. Adjusters can't beat the next hurricane. Aid programs go unmentioned. We are what happens when the standard answer doesn't fit your situation."
    image={heroPhoto}
    imageAlt=""
    size="tall"
  >
    <p class="actions">
      <a class="btn" href="/help">Get help</a>
      <a class="btn btn--ghost" href="/give/lantern-keeper">Become a Lantern Keeper</a>
    </p>
  </Hero>

  {STORM.active && <StormAlert />}

  <Section title="Where things stand" meta={`As of ${NOW.asOf}`}>
    <p class="intro">{NOW.lede}</p>
    <Grid min="280px">
      {NOW.items.map((item) => (
        <Card title={item.title}>
          <p>{item.body}</p>
        </Card>
      ))}
    </Grid>
  </Section>

  <Section title="What we did in 2024" rule space="tight">
    <p class="intro">
      In 2024, Hurricanes Helene and Milton hit Florida two weeks apart. We had no
      budget and no staff. We had hotel partnerships, a drone, volunteers, and a
      phone that kept ringing.
    </p>
    <Stats />
    <p class="more"><a href="/response">See the full response &rarr;</a></p>
  </Section>

  <Section title="What we can do for you today" rule>
    <Grid>
      <Card title="Document your damage" href="/help/recover" meta="Free, year-round">
        <p>
          A Florida-licensed home inspector and FAA-licensed drone pilot look at
          your roof and property, and you get a written report. It does not
          matter whether the damage is from last week or from Milton.
        </p>
      </Card>
      <Card title="Find aid nobody mentioned" href="/help/recover" meta="FEMA · SBA · local">
        <p>
          SBA disaster loans are available to homeowners, not just businesses.
          Almost nobody is told that. We sit down and go through what you may
          qualify for, and help you file it.
        </p>
      </Card>
      <Card title="Reach a person" href="/contact" meta="Storm line">
        <p>
          Official hotlines give official answers. Ours answers the question you
          actually asked — about your evacuation zone, your cracked window, your
          medical equipment, your animals.
        </p>
      </Card>
    </Grid>
    <p class="boundary">
      We are not insurance adjusters and we do not negotiate with your insurer.
      We inspect, we document, and we hand you the report. What you do with it is
      entirely yours.
    </p>
    <p class="more"><a href="/help">Before, during, and after a storm &rarr;</a></p>
  </Section>

  <Section tone="surface" title="One night in October" space="loose">
    <Grid min="320px">
      <Story name="Peter" context="Hurricane Milton · emergency lodging">
        <p>
          A college student, ordered out of their dorm. No family nearby. Shelters
          wouldn't take their cat — their only companion. When they called us, they
          were planning to ride out the storm in their car.
        </p>
        <p>We put them both in a hotel that night.</p>
        <blockquote>
          My cat and I have only been able to safely make it through Hurricane
          Milton because of the help given to us by this organization.
        </blockquote>
      </Story>
      <Story name="Amy" context="Helene, then Milton · relocation">
        <p>
          A single mother with two kids, two cats, and a dog. Helene flooded her
          house and totaled her car. Days later — before an adjuster could even
          visit — Milton arrived.
        </p>
        <p>
          We moved all six of them more than a hundred miles inland, hours before
          landfall. No forms. No waitlist.
        </p>
      </Story>
    </Grid>
    <PhotoPlaceholder
      subject="A family and their pets arriving somewhere safe before landfall"
      source="Shoot this ourselves, with written permission, the next time we place someone. Never stock — a stock photo beside Peter's or Amy's real story reads as documentation of that story, and it isn't."
      ratio="3 / 2"
    />
    <p class="more"><a href="/response">Read more stories &rarr;</a></p>
  </Section>

  <Section title="Where we came from" rule>
    <p class="intro">
      We started in 2015 as Sylvan Ramble Lights — a front-yard holiday light show
      in South Tampa that drew more than 20,000 neighbors and raised around
      $50,000 for local charities. It landed us on NBC Nightly News.
    </p>
    <p class="intro">
      In 2024 the storms came, and the same equipment, volunteers, and stubbornness
      got pointed somewhere new. We still bring light. We just do it earlier now.
    </p>
    <Figure
      src={lightShow}
      size="wide"
      alt="A crowd of neighbours filling the street outside a South Tampa house lit in green and purple for the Sylvan Ramble Lights show."
      caption="Sylvan Ramble Lights, South Tampa. On peak nights more than 500 people came."
    />
    <p class="more"><a href="/about">Our story &rarr;</a> &nbsp;·&nbsp; <a href="/about/press">Press coverage &rarr;</a></p>
  </Section>

  <Section title="The light show is coming back" rule space="tight">
    <p class="intro">
      From 2015 to 2023 the Sylvan Ramble light show drew more than 20,000
      neighbours to one South Tampa street. It's returning as
      <strong>Lanterns of Hope</strong> — a holiday display where sponsored
      lanterns fund storm recovery for Florida families.
    </p>
    <Figure
      src={audience}
      size="wide"
      alt="A large crowd seated and standing on a lawn under oak trees, watching the light show at dusk."
      caption="The audience it built. Lanterns of Hope starts from here."
    />
    <p class="more">
      <a class="btn" href="/events/lanterns-of-hope">About Lanterns of Hope</a>
    </p>
  </Section>

  <CallToAction title="The quiet years are the expensive ones" href="/give/lantern-keeper" cta="Become a Lantern Keeper">
    Anyone will give after a hurricane. The hard part is staying ready through two
    seasons when nothing happens — keeping the inspections running and the phone
    answered so that the next time, we say yes within the hour instead of starting
    from nothing. Even $10 a month does that.
  </CallToAction>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-md); }
  .intro { font-size: var(--step-1); }
  .more { margin-top: var(--space-md); font-family: var(--font-display); font-weight: 600; }
  .boundary {
    margin-top: var(--space-md);
    max-width: 56ch;
    font-size: var(--step--1);
    color: var(--color-text-muted);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-sm);
  }
</style>
