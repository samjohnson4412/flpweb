---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Card from '../components/Card.astro';
import Stats from '../components/Stats.astro';
import Story from '../components/Story.astro';
import CallToAction from '../components/CallToAction.astro';
import Figure from '../components/Figure.astro';
import lightShow from '../assets/photos/light-show-crowd.jpg';
import audience from '../assets/photos/light-show-audience.jpg';
import { ORG } from '../consts';
---

<BaseLayout
  title={ORG.name}
  description="A Tampa 501(c)(3) providing emergency lodging, storm inspections, cleanup, and preparedness support to Florida families — stepping in where the official answer doesn't fit."
>
  <Hero
    title="No family should face disaster alone"
    lede="When a storm is coming, the official advice is to seek shelter. But shelters turn away pets. Adjusters can't beat the next hurricane. Aid programs go unmentioned. We are what happens when the standard answer doesn't fit your situation."
  >
    <p class="actions">
      <a class="btn" href="/help">Get help</a>
      <a class="btn btn--ghost" href="/give/lantern-keeper">Become a Lantern Keeper</a>
    </p>
  </Hero>

  <Section tone="surface" title="What we actually did">
    <p class="intro">
      In 2024, Hurricanes Helene and Milton hit Florida two weeks apart. We had no
      budget and no staff. We had hotel partnerships, a drone, volunteers, and a
      phone that kept ringing.
    </p>
    <Stats />
    <p class="more"><a href="/response">See the full response &rarr;</a></p>
  </Section>

  <Section title="Wherever you are in the storm">
    <Grid>
      <Card title="Before" href="/help/prepare" meta="Prepare">
        <p>Preparedness workshops, readiness kits, and neighborhood weather stations that feed open-source forecasting.</p>
      </Card>
      <Card title="During" href="/help/during" meta="Ride it out or get out">
        <p>Evacuation and transportation help, emergency lodging that takes pets, and a storm hotline that answers real questions.</p>
      </Card>
      <Card title="After" href="/help/recover" meta="Recover">
        <p>Roof and property inspections, emergency repairs, debris removal, and help navigating FEMA, SBA, and local grants.</p>
      </Card>
    </Grid>
  </Section>

  <Section tone="surface" title="One night in October">
    <Grid min="320px">
      <Story name="Peter" context="Hurricane Milton · emergency lodging">
        <p>
          A college student, ordered out of their dorm. No family nearby. Shelters
          wouldn't take their cat — their only companion. When they called us, they
          were planning to ride out the storm in their car.
        </p>
        <p>We put them both in a hotel that night.</p>
        <blockquote>
          My cat and I have only been able to safely make it through Hurricane
          Milton because of the help given to us by this organization.
        </blockquote>
      </Story>
      <Story name="Amy" context="Helene, then Milton · relocation">
        <p>
          A single mother with two kids, two cats, and a dog. Helene flooded her
          house and totaled her car. Days later — before an adjuster could even
          visit — Milton arrived.
        </p>
        <p>
          We moved all six of them more than a hundred miles inland, hours before
          landfall. No forms. No waitlist.
        </p>
      </Story>
    </Grid>
    <p class="more"><a href="/response">Read more stories &rarr;</a></p>
  </Section>

  <Section title="Where we came from">
    <p class="intro">
      We started in 2015 as Sylvan Ramble Lights — a front-yard holiday light show
      in South Tampa that drew more than 20,000 neighbors and raised around
      $50,000 for local charities. It landed us on NBC Nightly News.
    </p>
    <p class="intro">
      In 2024 the storms came, and the same equipment, volunteers, and stubbornness
      got pointed somewhere new. We still bring light. We just do it earlier now.
    </p>
    <Figure
      src={lightShow}
      size="wide"
      alt="A crowd of neighbours filling the street outside a South Tampa house lit in green and purple for the Sylvan Ramble Lights show."
      caption="Sylvan Ramble Lights, South Tampa. On peak nights more than 500 people came."
    />
    <p class="more"><a href="/about">Our story &rarr;</a> &nbsp;·&nbsp; <a href="/about/press">Press coverage &rarr;</a></p>
  </Section>

  <Section tone="surface" title="The light show is coming back">
    <p class="intro">
      From 2015 to 2023 the Sylvan Ramble light show drew more than 20,000
      neighbours to one South Tampa street. It's returning as
      <strong>Lanterns of Hope</strong> — a holiday display where sponsored
      lanterns fund storm recovery for Florida families.
    </p>
    <Figure
      src={audience}
      size="wide"
      alt="A large crowd seated and standing on a lawn under oak trees, watching the light show at dusk."
      caption="The audience it built. Lanterns of Hope starts from here."
    />
    <p class="more">
      <a class="btn" href="/events/lanterns-of-hope">About Lanterns of Hope</a>
    </p>
  </Section>

  <CallToAction title="Storms don't wait for fundraisers" href="/give/lantern-keeper" cta="Become a Lantern Keeper">
    Monthly giving is what lets us say yes within the hour instead of waiting to
    see what comes in. Even $10 a month keeps the answer ready before the next
    storm has a name.
  </CallToAction>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-md); }
  .intro { font-size: var(--step-1); }
  .more { margin-top: var(--space-md); font-family: var(--font-display); font-weight: 600; }
</style>
