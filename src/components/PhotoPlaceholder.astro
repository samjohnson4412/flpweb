---
/**
 * A deliberate, visible gap where a photograph should go.
 *
 * Every image on this site must be FLP-owned or carry a licence we can produce
 * on demand — see CLAUDE.md and docs/IMAGE-CREDITS.md. These placeholders mark
 * the spots worth buying, so nothing ever gets filled with a stock photo in a
 * hurry. Replace with <Figure> and record the provenance in IMAGE-CREDITS.md.
 */
interface Props {
  subject: string;
  /** Where to get it: a Drive folder, a shoot to do, or a stock search. */
  source?: string;
  ratio?: string;
  size?: 'text' | 'wide';
}
const { subject, source, ratio = '16 / 9', size = 'wide' } = Astro.props;
// Sourcing notes and the licence rule are for us, not for visitors.
const internal = import.meta.env.DEV;
---
<figure class:list={['ph', `ph--${size}`]} style={`--ratio:${ratio}`}>
  <div class="frame">
    <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="2.5" y="4.5" width="19" height="15" rx="2" stroke="currentColor" stroke-width="1.4"/>
      <circle cx="8.5" cy="10" r="1.6" stroke="currentColor" stroke-width="1.4"/>
      <path d="M3 17l5-4.5 3.5 3L15 12l6 5.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
    <p class="subject">{internal ? subject : 'Photograph to come'}</p>
    {internal && source && <p class="source">{source}</p>}
    {internal && <p class="rule">FLP-owned or licensed only · log it in IMAGE-CREDITS.md</p>}
  </div>
</figure>

<style>
  .ph { margin: var(--space-md) 0; }
  .ph--text { max-width: min(100%, 34rem); }
  .ph--wide { max-width: min(100%, 52rem); }
  .frame {
    aspect-ratio: var(--ratio);
    max-height: 62vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.4rem; padding: var(--space-md); text-align: center;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(135deg,
        transparent 0 10px,
        rgb(30 58 95 / 0.035) 10px 20px),
      var(--color-surface);
    color: var(--color-text-muted);
  }
  .icon { width: 2rem; height: 2rem; opacity: 0.5; margin-bottom: 0.2rem; }
  .subject {
    margin: 0; max-width: 40ch;
    font-family: var(--font-display); font-weight: 700;
    color: var(--color-text); font-size: var(--step-0);
  }
  .source { margin: 0; max-width: 46ch; font-size: var(--step--1); }
  .rule {
    margin: 0.3rem 0 0; font-size: var(--step--1);
    text-transform: uppercase; letter-spacing: 0.08em;
    opacity: 0.65; font-size: 0.68rem;
  }
</style>
