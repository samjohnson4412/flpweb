---
import { STORM } from '../consts';
---
<aside class="alert" aria-label="Active storm">
  <div class="wrap inner">
    <p class="tag"><span class="dot" aria-hidden="true"></span>Active · as of {STORM.asOf}</p>
    <h2>{STORM.name}</h2>
    <p class="status">{STORM.status}</p>
    <p class="actions">
      <a class="btn" href={STORM.slug}>What we can help with</a>
      <a class="btn btn--ghost" href="/partner">Organizations: partner with us</a>
    </p>
  </div>
</aside>

<style>
  .alert {
    background: var(--flp-navy-900);
    color: var(--flp-white);
    border-top: 3px solid var(--color-accent);
    padding-block: var(--space-md);
  }
  .tag {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-display); font-size: var(--step--1);
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--flp-gold, #e8c37a); margin-bottom: 0.4rem;
  }
  .dot {
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: var(--flp-red-500, #d72638); flex: none;
    box-shadow: 0 0 0 0 rgb(215 38 56 / 0.7);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 0.6rem rgb(215 38 56 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(215 38 56 / 0); }
  }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  .alert h2 { margin: 0 0 0.3rem; font-size: var(--step-2); }
  .status { color: rgb(255 255 255 / 0.85); max-width: var(--measure); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin: var(--space-sm) 0 0; max-width: none; }
</style>
