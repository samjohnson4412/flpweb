---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  ratio?: string;
  priority?: boolean;
}
const { src, alt, caption, credit, ratio = '16 / 9', priority = false } = Astro.props;
---

<figure class="fig" data-reveal style={`--ratio:${ratio}`}>
  <div class="frame">
    <Image
      src={src}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 800px) 100vw, 800px"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      data-fade={priority ? undefined : ''}
    />
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && <span class="credit">{credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  .fig { margin: var(--space-md) 0 0; }
  .frame {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--flp-navy-900);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .fig:hover .frame :global(img) { transform: scale(1.02); }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }
  .credit { display: block; opacity: 0.75; }
  @media (prefers-reduced-motion: reduce) {
    .fig:hover .frame :global(img) { transform: none; }
  }
</style>
