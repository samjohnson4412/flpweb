---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  ratio?: string;
  priority?: boolean;
  /** 'text' sits within the reading column, 'wide' runs the full container. */
  size?: 'text' | 'wide';
}
const {
  src, alt, caption, credit, ratio = '16 / 9', priority = false, size = 'text',
} = Astro.props;
---

<figure class:list={['fig', `fig--${size}`]} data-reveal style={`--ratio:${ratio}`}>
  <div class="frame">
    <Image
      src={src}
      alt={alt}
      widths={[400, 640, 960]}
      sizes={size === 'wide'
        ? '(max-width: 56rem) 100vw, 832px'
        : '(max-width: 38rem) 100vw, 544px'}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      data-fade={priority ? undefined : ''}
    />
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && <span class="credit">{credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  /* Images sit with the text rather than shouting over it. A portrait crop at
     full container width ran well over a screen tall, which read as a mistake. */
  .fig { margin: var(--space-md) 0 0; }
  .fig--text { max-width: min(100%, 34rem); }
  .fig--wide { max-width: min(100%, 52rem); }
  .frame {
    aspect-ratio: var(--ratio);
    max-height: 62vh;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--flp-navy-900);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .fig:hover .frame :global(img) { transform: scale(1.02); }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }
  .credit { display: block; opacity: 0.75; }
  @media (prefers-reduced-motion: reduce) {
    .fig:hover .frame :global(img) { transform: none; }
  }
</style>
