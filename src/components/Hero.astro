---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  tone?: 'navy' | 'cream';
  glow?: boolean;
}
const { eyebrow, title, lede, tone = 'navy', glow = true } = Astro.props;
const showGlow = glow && tone === 'navy';
---

<section class:list={['hero', `hero--${tone}`]}>
  {showGlow && <div class="glow" aria-hidden="true"></div>}
  <div class="wrap inner">
    {eyebrow && <p class="eyebrow" data-enter>{eyebrow}</p>}
    <h1 data-enter style="--enter-delay:70ms">{title}</h1>
    {lede && <p class="lede" data-enter style="--enter-delay:150ms">{lede}</p>}
    <div data-enter style="--enter-delay:230ms"><slot /></div>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-lg); position: relative; overflow: hidden; isolation: isolate; }
  .inner { position: relative; z-index: 1; }
  .hero--navy { background: var(--flp-navy-900); color: var(--flp-white); }
  .hero--cream { background: var(--color-bg); border-bottom: 1px solid var(--color-border); }

  /* A lantern-coloured bloom, low contrast, well behind the text. */
  .glow {
    position: absolute;
    z-index: 0;
    top: -30%;
    right: -10%;
    width: min(62rem, 90%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(230 164 0 / 0.28) 0%,
      rgb(230 164 0 / 0.10) 42%,
      transparent 68%
    );
    filter: blur(28px);
    opacity: 0.6;
    pointer-events: none;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }
  .lede { font-size: var(--step-1); max-width: 60ch; }
  .hero--navy .lede { color: rgb(255 255 255 / 0.85); }
</style>
