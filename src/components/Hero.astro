---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  tone?: 'navy' | 'cream';
}
const { eyebrow, title, lede, tone = 'navy' } = Astro.props;
---

<section class:list={['hero', `hero--${tone}`]}>
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .hero { padding-block: var(--space-lg); }
  .hero--navy { background: var(--flp-navy-900); color: var(--flp-white); }
  .hero--cream { background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }
  .lede { font-size: var(--step-1); max-width: 60ch; }
  .hero--navy .lede { color: rgba(255, 255, 255, 0.85); }
</style>
