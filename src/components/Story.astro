---
interface Props { name: string; context: string; }
const { name, context } = Astro.props;
---
<article class="story">
  <h3>{name}</h3>
  <p class="ctx">{context}</p>
  <div class="body"><slot /></div>
</article>

<style>
  .story {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-md);
    border-top: 4px solid var(--color-accent);
  }
  .story h3 { font-size: var(--step-2); margin-bottom: 0.2rem; }
  .ctx {
    font-family: var(--font-display); font-size: var(--step--1);
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-text-muted); margin-bottom: var(--space-sm);
  }
  .body :global(blockquote) {
    margin: var(--space-sm) 0 0;
    padding-left: var(--space-sm);
    border-left: 3px solid var(--color-border);
    font-style: italic;
    color: var(--color-text-muted);
  }
  .body :global(p:last-child) { margin-bottom: 0; }
</style>
