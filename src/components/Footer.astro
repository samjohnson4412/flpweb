---
import { ORG, FOOTER_NAV } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="brandcol">
      <img src="/brand/logo-full-white.png" alt={ORG.name} width="1200" height="475" />
      <p class="charity">A 501(c)(3) public charity<br />EIN {ORG.ein}</p>
      <address>
        {ORG.address.street}<br />
        {ORG.address.city}, {ORG.address.region} {ORG.address.postalCode}<br />
        <a href={`mailto:${ORG.email}`}>{ORG.email}</a><br />
        <a href={`tel:${ORG.phoneHref}`}>{ORG.phone}</a>
      </address>
    </div>

    {FOOTER_NAV.map((col) => (
      <nav aria-label={col.heading}>
        <h2>{col.heading}</h2>
        <ul>
          {col.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="wrap legal">
    <p class="policies">
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/non-discrimination-policy">Non-Discrimination Policy</a>
    </p>
    <p>
      A COPY OF THE OFFICIAL REGISTRATION ({ORG.flRegistrationNumber}) AND FINANCIAL
      INFORMATION MAY BE OBTAINED FROM THE DIVISION OF CONSUMER SERVICES BY CALLING
      TOLL-FREE (800-435-7352) WITHIN THE STATE. REGISTRATION DOES NOT IMPLY
      ENDORSEMENT, APPROVAL, OR RECOMMENDATION BY THE STATE.
    </p>
    <p>&copy; {ORG.incorporated} – {year} {ORG.legalName}. Formerly {ORG.formerName}.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--flp-navy-900);
    color: var(--flp-white);
    padding-block: var(--space-lg) var(--space-md);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: var(--space-md);
  }
  .brandcol { min-width: 0; }
  .brandcol img { width: auto; height: 52px; margin-bottom: var(--space-sm); }
  .site-footer h2 {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .site-footer li { margin-bottom: 0.4rem; }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { color: var(--color-accent); }
  address { font-style: normal; font-size: var(--step--1); line-height: 1.7; }
  .charity { font-family: var(--font-display); font-weight: 600; margin-bottom: var(--space-sm); }
  .policies { display: flex; gap: var(--space-md); flex-wrap: wrap; margin-bottom: var(--space-sm); }
  .policies a { font-size: var(--step--1); }
  .legal {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.72rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
  }
  .legal p { max-width: none; }
</style>
