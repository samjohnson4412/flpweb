---
interface Props {
  title?: string;
  /** Small eyebrow above the title — used for date stamps, e.g. "As of October 2026". */
  meta?: string;
  lede?: string;
  tone?: 'default' | 'surface' | 'navy';
  /**
   * Vertical weight. This is how the page groups itself:
   *   tight  — continues the thought above it
   *   default— a new section within the same movement
   *   loose  — opens a new movement
   * Uniform spacing everywhere is what makes a page read as disconnected slabs.
   */
  space?: 'tight' | 'default' | 'loose';
  /** Hairline rule above the heading. Set false to suppress on the first section. */
  rule?: boolean;
  id?: string;
}
const {
  title, meta, lede, tone = 'default', space = 'default', rule, id,
} = Astro.props;

// Adjacent same-tone sections need *something* between them, or they merge into
// one undifferentiated run. A hairline is quieter than a colour change.
// Default off: a section immediately after a tonal change is already divided.
const showRule = rule ?? false;
---

<section class:list={['sec', `sec--${tone}`, `sp--${space}`, showRule && 'sec--ruled']} id={id}>
  <div class="wrap inner" data-reveal>
    {(meta || title) && (
      <header class="head">
        {meta && <p class="meta">{meta}</p>}
        {title && <h2>{title}</h2>}
      </header>
    )}
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .sec { padding-block: var(--space-lg); }
  .sp--tight { padding-block: var(--space-md); }
  .sp--loose { padding-block: var(--space-xl); }

  .sec--surface { background: var(--color-surface); }
  .sec--navy { background: var(--flp-navy-900); color: var(--flp-white); }

  /* Between two sections sharing a ground, a short accent tick on the left
     spine instead of a colour change. It marks the division without slabbing
     the page, and it lines every section head up on the same vertical axis. */
  .inner { position: relative; }
  .sec--ruled .inner::before {
    content: '';
    position: absolute;
    top: calc(var(--space-lg) * -0.52);
    left: 0;
    width: clamp(2.5rem, 14%, 7rem);
    border-top: 2px solid var(--color-accent);
    opacity: 0.5;
  }
  .sec--ruled.sp--tight .inner::before { top: calc(var(--space-md) * -0.52); }
  .sec--ruled.sp--loose .inner::before { top: calc(var(--space-xl) * -0.52); }

  .head { margin-bottom: var(--space-sm); }
  .head > * { margin-bottom: 0; }
  .meta {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .sec--navy .meta { color: var(--flp-gold, #e8c37a); }
  .lede { font-size: var(--step-1); color: var(--color-text-muted); max-width: 62ch; }
  .sec--navy .lede { color: rgba(255, 255, 255, 0.8); }
</style>
