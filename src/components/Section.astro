---
interface Props {
  title?: string;
  /** Eyebrow above the title — a category or a date stamp. */
  meta?: string;
  lede?: string;
  tone?: 'default' | 'surface' | 'navy';
  /**
   * Vertical weight — how the page groups itself.
   *   tight   continues the thought above it
   *   default a new section in the same movement
   *   loose   opens a new movement
   */
  space?: 'tight' | 'default' | 'loose';
  /** Suppress the seam mark — use on the first section under a hero. */
  seam?: boolean;
  /**
   * Header alignment. Left is the default and the right answer wherever prose
   * follows — centred body copy is measurably harder to read. Centre is only
   * for a header sitting over a symmetrical, full-width grid with no
   * paragraphs under it, where a hard-left heading looks orphaned.
   */
  align?: 'left' | 'center';
  /**
   * 'stack'  header above content, full width (the default)
   * 'split'  header in a narrow left rail, content in a wider right column.
   *          Fills the dead space to the right of a 64ch paragraph and gives
   *          the page a vertical spine. Stacks below 60rem.
   */
  layout?: 'stack' | 'split';
  id?: string;
}
const {
  title, meta, lede, tone = 'default', space = 'default', seam = true,
  align = 'left', layout = 'stack', id,
} = Astro.props;
---

<section
  class:list={['sec', `sec--${tone}`, `sp--${space}`, seam && 'sec--seam', align === 'center' && 'sec--centred', `lay--${layout}`]}
  id={id}
>
  <div class="wrap inner" data-reveal>
    {seam && <span class="tick" aria-hidden="true"></span>}
    <div class="cols">
      {(meta || title || lede) && (
        <header class="head">
          {meta && <p class="meta">{meta}</p>}
          {title && <h2>{title}</h2>}
          {lede && <p class="lede">{lede}</p>}
        </header>
      )}
      <div class="body"><slot /></div>
    </div>
  </div>
</section>

<style>
  .sec { padding-block: var(--space-lg); position: relative; }
  .sp--tight  { padding-block: var(--space-md); }
  .sp--loose  { padding-block: var(--space-xl); }

  .sec--surface { background: var(--color-surface); }
  .sec--navy    { background: var(--flp-navy-900); color: var(--flp-white); }

  /* The seam. A hairline across the full width marks the join, and a short
     gold tick sits *on* it, aligned to the content's left edge — so the
     boundary reads as a deliberate mark in a repeating system rather than
     the accidental edge where one colour stops and another starts. */
  .sec--seam { border-top: 1px solid var(--color-border); }
  .sec--navy.sec--seam { border-top-color: rgb(255 255 255 / 0.14); }

  .inner { position: relative; }
  .tick {
    position: absolute;
    left: 0;
    width: 3.25rem;
    height: 3px;
    background: var(--color-accent);
    border-radius: 2px;
  }
  .sp--default .tick { top: calc(var(--space-lg) * -1 - 2px); }
  .sp--tight   .tick { top: calc(var(--space-md) * -1 - 2px); }
  .sp--loose   .tick { top: calc(var(--space-xl) * -1 - 2px); }
  .sec--navy .tick { background: var(--flp-gold, #e8c37a); }

  /* Header anatomy is identical everywhere, so every section announces
     itself the same way and the page reads as chapters, not slabs. */
  .head { margin-bottom: var(--space-sm); }
  .head > :last-child { margin-bottom: 0; }

  /* Split layout. The header sits in its own rail so the prose column and the
     content column each have a right edge, instead of text trailing off into
     1180px of nothing. */
  @media (min-width: 60rem) {
    .lay--split .cols {
      display: grid;
      grid-template-columns: minmax(14rem, 19rem) 1fr;
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: start;
    }
    .lay--split .head { margin-bottom: 0; position: sticky; top: var(--space-md); }
    .lay--split .head :global(h2) { max-width: none; }
    .lay--split .lede { font-size: var(--step-0); max-width: none; }
    .lay--split .body > :global(p) { max-width: var(--measure); }
  }
  .meta {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .sec--navy .meta { color: var(--flp-gold, #e8c37a); }
  .lede { font-size: var(--step-1); color: var(--color-text-muted); max-width: 62ch; }

  /* Centred header. The tick moves to the middle with it, and the lede gets
     centred too — but only the header block. Body copy stays left wherever
     the slot puts it. */
  .sec--centred .head, .sec--centred .lede { text-align: center; }
  .sec--centred .head :global(h2) { margin-inline: auto; }
  .sec--centred .lede { margin-inline: auto; }
  .sec--centred .tick { left: 50%; transform: translateX(-50%); }
  .sec--navy .lede { color: rgb(255 255 255 / 0.8); }
</style>
