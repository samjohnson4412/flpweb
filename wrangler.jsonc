{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flpweb",
  "compatibility_date": "2026-09-13",

  // Static-assets-only Worker: there is no server code, so no "main" entry.
  // Cloudflare serves ./dist directly from its edge.
  "assets": {
    "directory": "./dist",

    // Astro builds directory-style routes (/about/ -> about/index.html).
    // "auto-trailing-slash" resolves both /about and /about/ to that file.
    "html_handling": "auto-trailing-slash",

    // Serve our own 404.html for unmatched paths.
    "not_found_handling": "404-page"
  }
}
